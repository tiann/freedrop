{
  "name": "freedrop",
  "version": "0.2.0",
  "description": "Direct file transfer between CLIs and browsers. No server touches your bytes: rendezvous over public MQTT brokers (encrypted), data over WebRTC, end to end.",
  "type": "module",
  "bin": {
    "freedrop": "cli.mjs"
  },
  "files": [
    "cli.mjs",
    "signal.mjs"
  ],
  "scripts": {
    "start": "node cli.mjs"
  },
  "keywords": [
    "file-transfer",
    "p2p",
    "webrtc",
    "serverless",
    "croc",
    "wormhole",
    "airdrop"
  ],
  "author": "weishu <twsxtd@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/tiann/freedrop#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tiann/freedrop.git"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "node-datachannel": "^0.32.3",
    "qrcode-terminal": "^0.12.0",
    "werift": "^0.24.3"
  }
}
