{
  "name": "freedrop",
  "version": "0.7.2",
  "description": "Direct file transfer between CLIs and browsers. No server touches your bytes: rendezvous over public MQTT brokers (encrypted), data over WebRTC, end to end.",
  "type": "module",
  "bin": {
    "freedrop": "cli.mjs"
  },
  "files": [
    "cli.mjs",
    "lock.mjs",
    "signal.mjs"
  ],
  "scripts": {
    "start": "node cli.mjs",
    "build": "node site/build.mjs",
    "test": "node --test test/lock.test.mjs test/cli.test.mjs test/qr.test.mjs test/site.test.mjs",
    "test:browser": "node --test test/browser.test.mjs"
  },
  "keywords": [
    "file-transfer",
    "p2p",
    "webrtc",
    "serverless",
    "croc",
    "wormhole",
    "airdrop"
  ],
  "author": "weishu <twsxtd@gmail.com>",
  "license": "MIT",
  "homepage": "https://freedrop.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tiann/freedrop.git"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "node-datachannel": "^0.32.3",
    "qrcode-terminal": "^0.12.0",
    "werift": "^0.24.3"
  },
  "devDependencies": {
    "playwright": "^1.62.1"
  }
}
